-- content types --
[multipart/form-data; boundary=abc] -> [abc]
[multipart/form-data; boundary="a b"] -> [a b]
[MULTIPART/FORM-DATA; BOUNDARY=abc] -> [abc]
[multipart/form-data] -> bad_request: the multipart Content-Type carries no boundary
[multipart/form-data; boundary=] -> bad_request: a multipart boundary must be 1 to 70 characters, not 0
[application/json] -> unsupported_media_type: this endpoint reads a multipart/form-data body, not 'application/json'
[] -> unsupported_media_type: this endpoint reads a multipart/form-data body, not ''
[multipart/form-data; boundary=0123456789012345678901234567890123456789012345678901234567890123456789X] -> bad_request: a multipart boundary must be 1 to 70 characters, not 71
